# Cloudflare Pages headers for daminiestate.ae
# Fonts and images are self-hosted. The third parties the CSP allows:
#   GoHighLevel (LeadConnector): chat widget, its phone field (stcdn), its font
#     CSS (fonts.bunny.net) and page tracking (link.msgsndr.com).
#     NOT allowed on purpose: the chat widget's attribution call to
#     services.msgsndr.com. It records a page visit for every visitor, including
#     those sending DNT or GPC. Allow it only if the client accepts that and
#     /privacy says so.
#   Yandex Metrica: tag.js from mc.yandex.ru. Hits and the Session Replay
#     websocket go to mc.yandex.com by default, cookie-sync iframes use
#     mc.yandex.com and mc.yandex.md (non-EU visitors).
# Cloudflare caps each _headers line at 2,000 characters, so keep the CSP lean.
# After any CSP change, load the live site and check the console for violations.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), browsing-topics=(), interest-cohort=(), display-capture=(), serial=(), hid=(), bluetooth=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-XSS-Protection: 0
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://widgets.leadconnectorhq.com https://beta.leadconnectorhq.com https://stcdn.leadconnectorhq.com https://services.leadconnectorhq.com https://link.msgsndr.com https://mc.yandex.ru https://mc.yandex.com; style-src 'self' 'unsafe-inline' https://widgets.leadconnectorhq.com https://beta.leadconnectorhq.com https://stcdn.leadconnectorhq.com https://fonts.bunny.net; font-src 'self' https://stcdn.leadconnectorhq.com https://fonts.bunny.net; img-src 'self' data: https://*.leadconnectorhq.com https://mc.yandex.ru https://mc.yandex.com https://yandex.ru https://*.yandex.ru; media-src 'self'; connect-src 'self' https://*.leadconnectorhq.com https://mc.yandex.ru https://mc.yandex.com https://mc.yandex.md wss://mc.yandex.ru wss://mc.yandex.com https://yandex.ru https://*.yandex.ru; frame-src https://widgets.leadconnectorhq.com https://*.leadconnectorhq.com https://mc.yandex.ru https://mc.yandex.com https://mc.yandex.md; frame-ancestors 'none'; form-action 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests; report-uri /api/csp-report;
  Cache-Control: public, max-age=0, must-revalidate

# HTML pages: revalidate quickly, serve stale while doing so.
/
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

# Fonts and images are stable, so cache hard.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable
/assets/img/developers/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800

# CSS/JS are not content-hashed on deploy → short TTL + revalidate after deploy.
/styles.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/main.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/loader-gate.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/ghl-tracking.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/yandex-metrika.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/*.webmanifest
  Cache-Control: public, max-age=86400
